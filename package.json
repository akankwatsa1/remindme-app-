{
  "name": "remindme",
  "productName": "RemindMe",
  "version": "1.4.0",
  "description": "An accessible to-do list with date and time reminders.",
  "main": "electron/main.js",
  "author": "You",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "icon": "node scripts/make-icon.js",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.remindme.app",
    "productName": "RemindMe",
    "files": [
      "www/**/*",
      "electron/**/*"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "www/assets/icon.ico"
    },
    "portable": {
      "artifactName": "RemindMe-Portable-${version}.exe"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "dependencies": {
    "@capacitor/android": "^7.6.8",
    "@capacitor/cli": "^7.6.8",
    "@capacitor/core": "^7.6.8",
    "@capacitor/local-notifications": "^7.0.7"
  }
}
